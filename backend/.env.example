APP_NAME="Smart Motel API"
DEBUG=true
CORS_ORIGINS=["http://localhost:5173"]

# MongoDB (docker compose exposes the dev instance on 27017)
MONGODB_URL=mongodb://motel:motel@localhost:27017/motel?authSource=admin
MONGODB_DB=motel

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720

# Public base URL used to build the email-verification link
PUBLIC_BASE_URL=http://localhost:5173

# Mail goes out over the Resend HTTP API (port 443), because the hosting plan
# blocks outbound SMTP on 25/465/587. Leave RESEND_API_KEY empty to log emails
# to the console instead of sending them. Key: resend.com → API Keys.
RESEND_API_KEY=
# Required alongside the key — the mailer stays in log mode without it, rather
# than guessing a sender the provider would reject. Must be an address on a
# domain verified in Resend; onboarding@resend.dev works without verifying a
# domain but only delivers to your own Resend account address.
EMAIL_FROM=

# Monthly invoice dispatch (day of month + hour, server local time)
INVOICE_CRON_DAY=5
INVOICE_CRON_HOUR=8

# Set to false where the process does not stay alive between requests (a free
# tier that sleeps); an external cron then drives the monthly run by calling
# POST /api/v1/invoices/dispatch.
SCHEDULER_ENABLED=true

# Shared secret for that endpoint, sent in the X-Cron-Secret header. Empty means
# the endpoint refuses every request — never that it is open. Put the real value
# in your own .env and in the GitHub Secret of the same name.
CRON_SECRET=

# Seed operator for `python -m scripts.seed`. Set the password in your own
# .env — it is intentionally empty here so no credential is ever committed,
# and the seed script refuses to run without it.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@smart.dev
SEED_ADMIN_PASSWORD=
