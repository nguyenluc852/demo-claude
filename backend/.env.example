APP_NAME="Smart Motel API"
DEBUG=true
CORS_ORIGINS=["http://localhost:5173"]

# MongoDB (docker compose exposes the dev instance on 27017)
MONGODB_URL=mongodb://motel:motel@localhost:27017/motel?authSource=admin
MONGODB_DB=motel

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720

# Public base URL used to build the email-verification link
PUBLIC_BASE_URL=http://localhost:5173

# SMTP — leave SMTP_HOST empty to log emails to the console instead of sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
SMTP_USE_TLS=true

# Monthly invoice dispatch (day of month + hour, server local time)
INVOICE_CRON_DAY=5
INVOICE_CRON_HOUR=8
